{
  "appId": "com.myfinancer.admin",
  "productName": "My Financer Admin",
  "extraMetadata": {
    "main": "electron/admin-main.cjs"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json",
    "build/**/*"
  ],
  "asar": false,
  "directories": {
    "output": "release/admin",
    "buildResources": "build"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icons/win/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "My Financer Admin",
    "installerIcon": "build/icons/win/icon.ico",
    "uninstallerIcon": "build/icons/win/icon.ico",
    "installerHeaderIcon": "build/icons/win/icon.ico"
  }
}
